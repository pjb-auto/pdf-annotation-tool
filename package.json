{
  "name": "pdf-annotation-tool",
  "version": "1.0.0",
  "description": "Offline PDF viewer and annotation tool",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "author": "PDF Tool <noreply@pdftool.app>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "signature_pad": "^5.0.4"
  },
  "build": {
    "appId": "com.pdftool.annotation",
    "productName": "PDF Annotation Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "pdf-annotation-tool",
      "synopsis": "Offline PDF viewer and annotation tool",
      "description": "Fully offline, local-first desktop app for viewing PDFs and adding non-destructive annotations (highlights, underlines, ink, and visual signatures).",
      "maintainer": "PDF Tool <noreply@pdftool.app>",
      "desktop": {
        "entry": {
          "Name": "PDF Annotation Tool",
          "Categories": "Office;Utility;Viewer;"
        }
      }
    },
    "appImage": {
      "artifactName": "PDF-Annotation-Tool-${version}.${ext}"
    },
    "deb": {
      "artifactName": "pdf-annotation-tool_${version}_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
